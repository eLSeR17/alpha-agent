# AlphaAgent configuration
# Copy this file to .env and fill in the values.

# --- LLM backend selection ------------------------------------------------
# ollama (default, free, local)  |  openai (cloud, requires API key)
ALPHA_AGENT_BACKEND=ollama

# --- Ollama connection (inside Docker network) ----------------------------
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b

# --- OpenAI-compatible backend (only used if ALPHA_AGENT_BACKEND=openai) --
# Works with OpenAI, Groq, Azure, vLLM, etc.
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1   # override for compatible providers

# --- Agent settings --------------------------------------------------------
MAX_ITERATIONS=5

# --- Response cache (optional) ---------------------------------------------
# Cache repeated queries in SQLite to save tokens and latency.
ALPHA_AGENT_CACHE=0
ALPHA_AGENT_CACHE_PATH=cache.sqlite3
ALPHA_AGENT_CACHE_TTL=3600

# --- Server ---------------------------------------------------------------
LOG_LEVEL=INFO
