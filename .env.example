# AlphaAgent configuration
# Copy this file to .env and fill in the values.

# --- LLM backend selection ------------------------------------------------
# ollama (default, free, local)  |  openai (cloud, requires API key)
ALPHA_AGENT_BACKEND=ollama

# --- Ollama connection (inside Docker network) ----------------------------
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b

# --- OpenAI-compatible backend (only used if ALPHA_AGENT_BACKEND=openai) --
# Works with OpenAI, Groq, Azure, vLLM, etc.
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1   # override for compatible providers

# --- Agent settings --------------------------------------------------------
MAX_ITERATIONS=5

# --- Response cache (optional) ---------------------------------------------
# Cache repeated queries in SQLite to save tokens and latency.
ALPHA_AGENT_CACHE=0
ALPHA_AGENT_CACHE_PATH=cache.sqlite3
ALPHA_AGENT_CACHE_TTL=3600

# --- Server ---------------------------------------------------------------
LOG_LEVEL=INFO

# --- Auth (API key mode) ----------------------------------------------------
# none (default, local dev) | api_key (requires X-API-Key header)
# Create keys with: PYTHONPATH=src python scripts/create_api_key.py --name <name>
ALPHA_AGENT_AUTH=none
ALPHA_AGENT_AUTH_DB=auth.sqlite3

# --- Rate limiting (api_key mode only, per key) -----------------------------
# Default requests/minute when the key does not specify its own limit.
ALPHA_AGENT_RATE_LIMIT=60

# --- Multi-turn sessions ----------------------------------------------------
# SQLite store backing POST /sessions and session_id in /ask.
ALPHA_AGENT_SESSIONS_DB=sessions.sqlite3

# --- Server ---------------------------------------------------------------
# LOG_LEVEL=INFO
